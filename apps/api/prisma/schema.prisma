generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  EDITOR
  COMMENTER
  VIEWER
}

enum DashboardStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DashboardSharePermission {
  VIEW
  EDIT
}

enum StoredFilePurpose {
  WORKSPACE
  AVATAR
  COVER
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String?
  googleSubject String?   @unique
  displayName   String
  avatarUrl     String?
  jobTitle      String?
  bio           String?
  timezone      String    @default("UTC")
  locale        String    @default("en")
  preferences   Json      @default("{}")
  emailVerified Boolean   @default(false)
  mfaTotpSecretEnc String?
  mfaTotpEnabledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  sessions      Session[]
  workspaces    Workspace[] @relation("WorkspaceOwner")
  memberships   WorkspaceMember[]
  dashboardPreferences DashboardPreference[]
  dashboards    Dashboard[] @relation("DashboardOwner")
  auditEvents   AuditEvent[] @relation("AuditActor")
  workspaceInvitesCreated WorkspaceInvite[] @relation("WorkspaceInviteCreator")
  dashboardSharesCreated DashboardShare[] @relation("DashboardShareCreator")
  dashboardTemplatesCreated DashboardTemplate[] @relation("DashboardTemplateCreator")
  installedWorkspacePlugins WorkspacePlugin[] @relation("WorkspacePluginInstaller")
  dashboardTemplateFavorites DashboardTemplateFavorite[]
  dashboardComments DashboardComment[] @relation("DashboardCommentAuthor")
  resolvedDashboardComments DashboardComment[] @relation("DashboardCommentResolver")
  notifications       Notification[] @relation("NotificationRecipient")
  notificationsSent   Notification[] @relation("NotificationActor")
  uploadedFiles      StoredFile[] @relation("StoredFileUploader")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  mfaChallenges MfaChallenge[]
  mfaRecoveryCodes MfaRecoveryCode[]

  @@index([createdAt])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  tokens    RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  rotatedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name        String
  slug        String   @unique
  description String?
  icon        String   @default("grid")
  accentColor String   @default("violet")
  coverImageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  archivedAt  DateTime?
  members     WorkspaceMember[]
  dashboards  Dashboard[]
  auditEvents AuditEvent[]
  invites     WorkspaceInvite[]
  templates   DashboardTemplate[]
  files       StoredFile[]
  plugins     WorkspacePlugin[]
  storageUsedBytes  BigInt @default(0)
  storageQuotaBytes BigInt @default(1073741824)

  @@index([ownerId, updatedAt])
}

model WorkspaceMember {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  userId      String              @db.Uuid
  role        WorkspaceMemberRole @default(VIEWER)
  isFavorite  Boolean             @default(false)
  isPinned    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspacePlugin {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  pluginId      String
  version       String
  widgetTypes   String[]  @default([])
  installedById String?   @db.Uuid
  installedAt   DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installedBy   User?     @relation("WorkspacePluginInstaller", fields: [installedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, pluginId])
  @@index([pluginId, version])
  @@index([installedById, installedAt])
}

model Dashboard {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  ownerId     String          @db.Uuid
  name        String
  slug        String
  description String?
  status      DashboardStatus @default(DRAFT)
  scene       Json            @default("{}")
  version     Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User            @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  versions    DashboardVersion[]
  shares      DashboardShare[]
  preferences DashboardPreference[]
  comments    DashboardComment[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, updatedAt])
}

model DashboardVersion {
  id          String   @id @default(uuid()) @db.Uuid
  dashboardId String   @db.Uuid
  version     Int
  scene       Json
  createdAt   DateTime @default(now())
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, version])
  @@index([dashboardId, createdAt])
}

model DashboardComment {
  id          String    @id @default(uuid()) @db.Uuid
  dashboardId String    @db.Uuid
  authorId    String?   @db.Uuid
  parentId    String?   @db.Uuid
  resolvedById String?  @db.Uuid
  body        String
  anchor      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  deletedAt   DateTime?
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  author      User?     @relation("DashboardCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent      DashboardComment? @relation("DashboardCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     DashboardComment[] @relation("DashboardCommentThread")
  resolvedBy  User?     @relation("DashboardCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([dashboardId, createdAt])
  @@index([authorId, createdAt])
  @@index([dashboardId, parentId, createdAt])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  actorId     String?   @db.Uuid
  type        String
  title       String
  message     String
  payload     Json      @default("{}")
  readAt      DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, archivedAt, createdAt])
  @@index([userId, readAt, archivedAt])
}

model StoredFile {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  uploaderId  String?   @db.Uuid
  storageKey  String    @unique
  originalName String   @db.VarChar(255)
  contentType String
  sizeBytes   BigInt
  sha256      String    @db.Char(64)
  purpose     StoredFilePurpose @default(WORKSPACE)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader    User?     @relation("StoredFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, deletedAt, createdAt])
  @@index([uploaderId, createdAt])
}

model DashboardPreference {
  id          String    @id @default(uuid()) @db.Uuid
  dashboardId String    @db.Uuid
  userId      String    @db.Uuid
  isFavorite  Boolean   @default(false)
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([userId, isPinned, isFavorite])
}

model DashboardTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  createdById String?   @db.Uuid
  name        String
  description String?
  category    String    @default("General")
  tags        String[]  @default([])
  scene       Json
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("DashboardTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  favorites   DashboardTemplateFavorite[]

  @@index([workspaceId, isPublished, updatedAt])
  @@index([createdById, updatedAt])
}

model DashboardTemplateFavorite {
  id         String           @id @default(uuid()) @db.Uuid
  templateId String           @db.Uuid
  userId     String           @db.Uuid
  createdAt  DateTime         @default(now())
  template   DashboardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([userId, createdAt])
}

model WorkspaceInvite {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  createdById String?             @db.Uuid
  email       String
  role        WorkspaceMemberRole @default(VIEWER)
  tokenHash   String              @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation("WorkspaceInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([email, expiresAt])
}

model DashboardShare {
  id          String                   @id @default(uuid()) @db.Uuid
  dashboardId String                   @db.Uuid
  createdById String?                  @db.Uuid
  permission  DashboardSharePermission @default(VIEW)
  tokenHash   String                   @unique
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime                 @default(now())
  dashboard   Dashboard                @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  createdBy   User?                    @relation("DashboardShareCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([dashboardId, createdAt])
  @@index([expiresAt])
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  workspaceId  String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([resourceType, resourceId])
}
